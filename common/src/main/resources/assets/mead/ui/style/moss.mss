/* Flexbox utilities for Mead UI */

.flex-1 {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.flex-col {
    flex-direction: column;
}
.flex-row {
    flex-direction: row;
}
.flex-wrap {
    flex-wrap: wrap;
}

/* Size */
.size-full {
    width: 100%;
    height: 100%;
}
.size-auto {
    width: auto;
    height: auto;
}

/* Width and height */
.width-full {
    width: 100%;
}
.width-auto {
    width: auto;
}
.width-1 {

}

.height-full {
    height: 100%;
}
.height-auto {
    height: auto;
}