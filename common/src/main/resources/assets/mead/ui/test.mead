<Mead flavor="styled">
    <Import src="style/mead.mss" />
    <Import src="style/moss.mss" />
    <Rect class="size-full">
        <Rect class="width-full" height="20" flex-direction="row-reverse" background-color="#f88">
            <Button width="20" height="20" action="exitScreen">x</Button>
            <Button width="20" height="20">i</Button>
        </Rect>
        <Rect width="100%" flex-grow="1" flex-direction="row" background-color="#88f">
            <Rect width="20%" height="100%" background-color="#8f8"/>
            <Button action="sayHello">Click me</Button>
        </Rect>
    </Rect>
</Mead>
