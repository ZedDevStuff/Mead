<Mead flavor="styled">
    <Style src="style/mead.mss" />
    <Rect width="100%" height="100%" backgroundColor="#fff">
        <Rect width="100%" height="20" flexDirection="row-reverse" backgroundColor="#f88">
            <Button width="20" height="20" action="exitScreen">x</Button>
            <Button width="20" height="20">i</Button>
        </Rect>
        <Rect width="100%" flexGrow="1" flexDirection="row" backgroundColor="#88f">
            <Rect width="20%" height="100%" backgroundColor="#8f8"/>
            <Button action="sayHello">Click me</Button>
        </Rect>
    </Rect>
</Mead>